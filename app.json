{
  "expo": {
    "name": "שעת אפס",
    "slug": "AgamApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-app.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matan15455.agamapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4FB",
        "foregroundImage": "./assets/icon-app.png",
      },
      "package": "com.matan15455.agamapp"
    },
    "web": {
      "favicon": "./assets/icon-app.png"
    },
    "plugins": [
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "a123e914-c038-4a78-a500-a39cea226242"
      }
    }
  }
}
